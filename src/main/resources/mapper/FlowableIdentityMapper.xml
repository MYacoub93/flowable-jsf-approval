<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.approval.mapper.FlowableIdentityMapper">

    <!-- جلب المستخدم مع فك تشفير كلمة المرور مباشرة داخل استعلام الـ SQL -->
    <select id="findUserByUsernameForAuth" resultType="org.flowable.idm.engine.impl.persistence.entity.UserEntityImpl">
        SELECT
            ID_ as id,
            USERNAME_ as username,
            FIRST_NAME_ as firstName,
            LAST_NAME_ as lastName,
            EMAIL_ as email,
            NVL(dic_pkg.decrypt_data('a1t1s25375752334', PASSWORD_), TRIM(USERNAME_)) as password
        FROM FLOWABLE_USERS_VW
        WHERE USERNAME_ = LOWER(#{username})
    </select>

    <!-- جلب مستخدم بواسطة الـ ID -->
    <select id="findUserById" resultType="org.flowable.idm.engine.impl.persistence.entity.UserEntityImpl">
        SELECT
            ID_ as id,
            FIRST_NAME_ as firstName,
            LAST_NAME_ as lastName,
            EMAIL_ as email,
            PASSWORD_ as password
        FROM FLOWABLE_USERS_VW
        WHERE ID_ = #{id}
    </select>

    <!-- جلب مستخدم بواسطة اسم المستخدم -->
    <select id="findUserByUsername" resultType="org.flowable.idm.engine.impl.persistence.entity.UserEntityImpl">
        SELECT
            ID_ as id,
            FIRST_NAME_ as firstName,
            LAST_NAME_ as lastName,
            EMAIL_ as email,
            PASSWORD_ as password
        FROM FLOWABLE_USERS_VW
        WHERE USERNAME_ = LOWER(#{username})
    </select>

    <!-- جلب أدوار المستخدم كمجموعات Flowable -->
    <select id="findGroupsByUser" resultType="org.flowable.idm.engine.impl.persistence.entity.GroupEntityImpl">
        SELECT
            id,
            name,
            type
        FROM
            flowable_groups_vw
        WHERE
            USER_ID = #{userId}
    </select>

    <!-- جلب مجموعة بواسطة المعرف (تُستخدم من قبل ClearanceService.isMemberOfGroup
         وغيرها من الاستعلامات التي لا تحمل userId) -->
    <select id="findGroupById" resultType="org.flowable.idm.engine.impl.persistence.entity.GroupEntityImpl">
        SELECT
            id,
            name,
            type
        FROM
            flowable_groups_vw
        WHERE
            ID = #{groupId}
    </select>

    <!-- عناوين البريد الإلكتروني لجميع أعضاء المجموعة، مسحوبة مباشرة من
         FLOWABLE_USERS_VW عبر استعلام خاص. يُستخدم من نظام الإشعارات
         العالمي لإرسال رسالة واحدة إلى كل معتمدي المجموعة المرشحة.
         ROLE_CODE_ هو معرف المجموعة (الرول) داخل العرض. -->
    <select id="findEmailsByGroup" resultType="java.lang.String">
        SELECT DISTINCT
            u.EMAIL_
        FROM FLOWABLE_USERS_VW u
        WHERE u.ROLE_CODE_ = #{groupId}
          AND u.EMAIL_ IS NOT NULL
        ORDER BY u.EMAIL_
    </select>

    <!-- البريد الإلكتروني لمستخدم واحد (يُستخدم عندما تكون المهمة محجوزة
         claimed لشخص معين، أو لإشعار المُبادر بالنتيجة النهائية). -->
    <select id="findEmailByUsername" resultType="java.lang.String">
        SELECT
            MAX(u.EMAIL_)
        FROM FLOWABLE_USERS_VW u
        WHERE u.USERNAME_ = LOWER(#{username})
          AND u.EMAIL_ IS NOT NULL
    </select>

</mapper>