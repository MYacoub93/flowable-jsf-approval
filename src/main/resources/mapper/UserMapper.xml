<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.approval.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.example.approval.entity.SystemUser">
        <id     property="id"         column="id"/>
        <result property="defaultRole"   column="default_role"/>
        <result property="keyType"   column="key_type"/>
        <result property="username" column="username"/>
        <result property="password"       column="password"/>
        <result property="webEnabled"      column="web_enabled"/>
        <result property="userID"     column="user_id"/>
    </resultMap>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT id,default_role,key_type,username,password,web_enabled,user_id
        FROM users;
        WHERE username = #{username}
          AND web_enabled = 1
        LIMIT 1
    </select>



</mapper>
