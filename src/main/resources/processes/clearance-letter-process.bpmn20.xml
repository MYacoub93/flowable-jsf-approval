<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowable.org/samples"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <!-- ===================================================================
       Clearance Letter
       - Started by candidate group STD only (process-level
         candidateStarterGroups + runtime check in ClearanceService).
       - Departments are NEVER hardcoded here: resolveDepartments calls
         DepartmentResolverService.getRequiredDepartments(initiator),
         MINUS the departments that already APPROVED this request in an
         earlier round (cumulative approvedDepartments process variable
         maintained by evaluateDepartmentStage), and stores the remaining
         pending departments in requiredDepartments.
       - RESUBMISSION RULE: when the request is amended after a rejection,
         a department that already approved never receives a second
         departmentApprovalTask - only departments that have not approved
         yet (rejected or never asked) circulate again. The FIRST round
         always contains every required department.
       - gatewayDepartmentsPending guards the (parallel) multi-instance
         stage: if nothing is pending (e.g. every department approved but
         Finance or Admission rejected), the department stage is skipped
         entirely and the flow continues with the sequential stages.
       - One multi-instance PARALLEL user task creates an approval task per
         pending department; candidateGroups=${department}. The stage is a
         SYNCHRONIZATION BARRIER: completionCondition
         ${nrOfCompletedInstances == nrOfInstances} guarantees the process
         only leaves the stage after EVERY pending department submitted
         (approve or reject). A rejection never cancels sibling tasks, so
         the Amendment Task can never exist while any department task is
         still pending.
       - Rejection at any stage loops back to the initiator amendment task
         and then re-resolves departments (the loop may repeat endlessly).
       - After ALL departments + Finance + Admission approved:
         completeClearance sets clearanceResult=APPROVED, e-mails the
         initiator and creates non-blocking standalone result / FYI tasks.
       =================================================================== -->
  <process id="clearanceLetterProcess" name="Clearance Letter" isExecutable="true" flowable:candidateStarterGroups="STD">

    <documentation>Dynamic multi-instance clearance approval with amendment loop; resubmissions skip departments that already approved.</documentation>

<!--    <extensionElements>-->
<!--      &lt;!&ndash; Only members of the STD candidate group may start this process. &ndash;&gt;-->
<!--      <flowable:candidateStarterGroups>STD</flowable:candidateStarterGroups>-->
<!--    </extensionElements>-->

    <!-- ===================== Start ===================== -->
    <startEvent id="startClearance" name="Clearance request started (STD)"
                flowable:formKey="start-clearance">
      <extensionElements>
        <flowable:executionListener event="start"
              expression="${clearanceProcessHandler.processStarted(execution)}"/>
      </extensionElements>
    </startEvent>

    <!-- ============ Dynamic department resolution ============ -->
    <serviceTask id="resolveDepartments" name="Resolve Pending Departments"
                 flowable:expression="${clearanceProcessHandler.resolveRequiredDepartments(execution)}">
      <documentation>
        Calls DepartmentResolverService.getRequiredDepartments(initiator) and removes every
        department that already APPROVED this request in an earlier round (cumulative
        approvedDepartments variable). The remaining PENDING departments are stored in
        requiredDepartments. Runs before EVERY approval round (start + after each
        amendment) so the department set is always dynamic; approved departments are
        never asked twice, rejected ones keep circulating until they approve.
      </documentation>
    </serviceTask>

    <!-- ============ Pending-department guard ============ -->
    <!-- Empty requiredDepartments (every required department already approved,
         e.g. a Finance/Admission rejection triggered the resubmission) must NOT
         reach the multi-instance stage: the whole department stage is skipped
         and the flow continues with the sequential Finance/Admission stages.
         The default (no pending departments) route requires no condition, so a
         missing/empty collection can never break the process. -->
    <exclusiveGateway id="gatewayDepartmentsPending" name="Departments still pending?"
                      default="flowNoPendingDepartments"/>

    <!-- ============ Parallel multi-instance department approval ============ -->
    <userTask id="departmentApprovalTask" name="Approval: ${department}"
              flowable:candidateGroups="${department}"
              flowable:formKey="clearance-task">
      <documentation>
        One instance per PENDING department (parallel) - departments that already
        approved in an earlier round are filtered out by resolveDepartments and
        never receive a second task for the same request. Approve / Reject. The
        shared ${clearanceTaskListener} sends the TASK_ASSIGNED e-mail + audit on
        create and records the decision on complete. SYNCHRONIZATION BARRIER: the
        completion condition requires nrOfCompletedInstances == nrOfInstances, so
        every pending department must submit its task before the stage can be
        left. A rejection is merely recorded (anyDepartmentRejected=true, consumed
        by the gatewayAllApproved gateway AFTER the barrier) and never cancels
        still-open sibling tasks.
      </documentation>
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${requiredDepartments}"
                                        flowable:elementVariable="department">
        <!-- SYNCHRONIZATION BARRIER: the stage may only be left when EVERY
             department instance has completed/submitted its task
             (nrOfCompletedInstances == nrOfInstances). A single rejection
             must NOT short-circuit the stage: the remaining department tasks
             stay active until each department has submitted, so the
             Amendment Task can never be created while any required
             department task is still pending. Whether an amendment is
             needed is decided afterwards by gatewayAllApproved using
             ${anyDepartmentRejected}. -->
        <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <!-- ============ Stage evaluation / rejection bookkeeping ============ -->
    <serviceTask id="evaluateDepartments" name="Evaluate Department Stage Result"
                 flowable:expression="${clearanceProcessHandler.evaluateDepartmentStage(execution)}">
      <documentation>
        Runs after the multi-instance barrier released the flow (ALL pending
        departments submitted) and on the gatewayDepartmentsPending skip route
        (nothing pending). Adds every department that APPROVED in this round to
        the cumulative approvedDepartments variable (consumed by the next
        resolveDepartments round) and copies the first rejection of the round
        (department + comment) into lastRejected* variables for the initiator's
        amendment form.
      </documentation>
    </serviceTask>

    <exclusiveGateway id="gatewayAllApproved" name="All departments approved?"/>

    <!-- ============ Step 1: Finance (sequential) ============ -->
    <userTask id="financeApprovalTask" name="Finance Department Approval"
              flowable:candidateGroups="FIN"
              flowable:formKey="clearance-task">
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <exclusiveGateway id="gatewayFinanceDecision" name="Finance approved?"/>

    <serviceTask id="recordFinanceRejection" name="Record Finance Rejection"
                 flowable:expression="${clearanceProcessHandler.recordStageRejection(execution, 'FINANCE', 'Finance Department')}"/>

    <!-- ============ Step 2: Admission and Registration (sequential) ============ -->
    <userTask id="admissionApprovalTask" name="Admission and Registration Approval"
              flowable:candidateGroups="REG"
              flowable:formKey="clearance-task">
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <exclusiveGateway id="gatewayAdmissionDecision" name="Admission approved?"/>

    <serviceTask id="recordAdmissionRejection" name="Record Admission Rejection"
                 flowable:expression="${clearanceProcessHandler.recordStageRejection(execution, 'ADMISSION_AND_REGISTRATION', 'Admission and Registration Department')}"/>

    <!-- ============ Initiator amendment (rejection loop) ============ -->
    <userTask id="amendClearanceRequestTask" name="Amend Clearance Request"
              flowable:assignee="${initiator}"
              flowable:formKey="clearance-task">
      <documentation>
        Returned to the ORIGINAL initiator whenever any department, Finance or
        Admission rejects. Shows lastRejectedStage / lastRejectedDepartment /
        lastRejectionComment. Completing it loops back to Resolve Required
        Departments - a fresh approval round starts (dynamic again, but
        departments that already approved are skipped). GUARANTEE: reachable
        only through gatewayAllApproved / gatewayFinanceDecision /
        gatewayAdmissionDecision - i.e. only after the multi-instance
        synchronization barrier released (ALL required department tasks
        submitted).
      </documentation>
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <serviceTask id="recordAmendment" name="Record Amendment"
                 flowable:expression="${clearanceProcessHandler.recordAmendment(execution)}"/>

    <!-- ============ Completion ============ -->
    <serviceTask id="completeClearance" name="Complete Clearance (Result + FYI)"
                 flowable:expression="${clearanceProcessHandler.completeClearance(execution)}">
      <documentation>
        Only reached when ALL dynamically selected departments, Finance and
        Admission approved. Sets clearanceResult=APPROVED, e-mails the
        initiator, creates the initiator result task and the Internal Audit
        FYI task (standalone tasks - neither blocks the process end).
      </documentation>
    </serviceTask>

    <endEvent id="endClearance" name="Clearance finished"/>

    <!-- ===================== Flows ===================== -->
    <sequenceFlow id="flowStart" sourceRef="startClearance" targetRef="resolveDepartments"/>

    <sequenceFlow id="flowResolveToGateway" sourceRef="resolveDepartments"
                  targetRef="gatewayDepartmentsPending"/>

    <sequenceFlow id="flowPendingToDepartments" name="pending departments"
                  sourceRef="gatewayDepartmentsPending" targetRef="departmentApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${requiredDepartments != null &amp;&amp; !requiredDepartments.isEmpty()}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowNoPendingDepartments" name="all already approved"
                  sourceRef="gatewayDepartmentsPending" targetRef="evaluateDepartments"/>

    <sequenceFlow id="flowDepartmentsToEvaluation" sourceRef="departmentApprovalTask"
                  targetRef="evaluateDepartments"/>

    <sequenceFlow id="flowEvaluationToGateway" sourceRef="evaluateDepartments"
                  targetRef="gatewayAllApproved"/>

    <sequenceFlow id="flowAllApprovedYes" name="all approved"
                  sourceRef="gatewayAllApproved" targetRef="financeApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${!anyDepartmentRejected}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAllApprovedNo" name="rejected"
                  sourceRef="gatewayAllApproved" targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowFinanceToGateway" sourceRef="financeApprovalTask"
                  targetRef="gatewayFinanceDecision"/>

    <sequenceFlow id="flowFinanceApproved" name="approved"
                  sourceRef="gatewayFinanceDecision" targetRef="admissionApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowFinanceRejected" name="rejected"
                  sourceRef="gatewayFinanceDecision" targetRef="recordFinanceRejection"/>
    <sequenceFlow id="flowRecordFinanceRejection" sourceRef="recordFinanceRejection"
                  targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowAdmissionToGateway" sourceRef="admissionApprovalTask"
                  targetRef="gatewayAdmissionDecision"/>

    <sequenceFlow id="flowAdmissionApproved" name="approved"
                  sourceRef="gatewayAdmissionDecision" targetRef="completeClearance">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAdmissionRejected" name="rejected"
                  sourceRef="gatewayAdmissionDecision" targetRef="recordAdmissionRejection"/>
    <sequenceFlow id="flowRecordAdmissionRejection" sourceRef="recordAdmissionRejection"
                  targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowAmendToRecord" sourceRef="amendClearanceRequestTask"
                  targetRef="recordAmendment"/>

    <!-- the amendment loop: back to dynamic department resolution -->
    <sequenceFlow id="flowAmendmentLoop" name="re-resolve departments"
                  sourceRef="recordAmendment" targetRef="resolveDepartments"/>

    <sequenceFlow id="flowCompleteToEnd" sourceRef="completeClearance"
                  targetRef="endClearance"/>

  </process>

  <!-- ===================== Diagram (layout only, engine-irrelevant) ===================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_clearanceLetterProcess">
    <bpmndi:BPMNPlane bpmnElement="clearanceLetterProcess" id="BPMNPlane_clearanceLetterProcess">
      <bpmndi:BPMNShape bpmnElement="startClearance" id="BPMNShape_start">
        <omgdc:Bounds height="30.0" width="30.0" x="60.0" y="200.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="resolveDepartments" id="BPMNShape_resolve">
        <omgdc:Bounds height="60.0" width="120.0" x="140.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gatewayDepartmentsPending" id="BPMNShape_gwPending">
        <omgdc:Bounds height="40.0" width="40.0" x="280.0" y="195.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="departmentApprovalTask" id="BPMNShape_departments">
        <omgdc:Bounds height="80.0" width="160.0" x="340.0" y="175.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="evaluateDepartments" id="BPMNShape_eval">
        <omgdc:Bounds height="60.0" width="120.0" x="580.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gatewayAllApproved" id="BPMNShape_gwAll">
        <omgdc:Bounds height="40.0" width="40.0" x="745.0" y="195.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="financeApprovalTask" id="BPMNShape_finance">
        <omgdc:Bounds height="60.0" width="140.0" x="830.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gatewayFinanceDecision" id="BPMNShape_gwFin">
        <omgdc:Bounds height="40.0" width="40.0" x="1005.0" y="195.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="admissionApprovalTask" id="BPMNShape_admission">
        <omgdc:Bounds height="60.0" width="160.0" x="1090.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gatewayAdmissionDecision" id="BPMNShape_gwAdm">
        <omgdc:Bounds height="40.0" width="40.0" x="1285.0" y="195.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="completeClearance" id="BPMNShape_complete">
        <omgdc:Bounds height="60.0" width="140.0" x="1370.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endClearance" id="BPMNShape_end">
        <omgdc:Bounds height="28.0" width="28.0" x="1550.0" y="201.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="recordFinanceRejection" id="BPMNShape_recFin">
        <omgdc:Bounds height="60.0" width="120.0" x="905.0" y="330.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="recordAdmissionRejection" id="BPMNShape_recAdm">
        <omgdc:Bounds height="60.0" width="120.0" x="1185.0" y="430.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="amendClearanceRequestTask" id="BPMNShape_amend">
        <omgdc:Bounds height="60.0" width="160.0" x="640.0" y="430.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="recordAmendment" id="BPMNShape_recAmend">
        <omgdc:Bounds height="60.0" width="120.0" x="440.0" y="430.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flowStart" id="BPMNEdge_flowStart">
        <omgdi:waypoint x="90.0" y="215.0"/>
        <omgdi:waypoint x="140.0" y="215.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowResolveToGateway" id="BPMNEdge_flowResolve">
        <omgdi:waypoint x="260.0" y="215.0"/>
        <omgdi:waypoint x="280.0" y="215.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowPendingToDepartments" id="BPMNEdge_pendingDepts">
        <omgdi:waypoint x="320.0" y="215.0"/>
