      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="admissionApprovalTask" id="BPMNShape_admission">
        <omgdc:Bounds height="60.0" width="160.0" x="1030.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gatewayAdmissionDecision" id="BPMNShape_gwAdm">
        <omgdc:Bounds height="40.0" width="40.0" x="1225.0" y="195.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="completeClearance" id="BPMNShape_complete">
        <omgdc:Bounds height="60.0" width="140.0" x="1310.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endClearance" id="BPMNShape_end">
        <omgdc:Bounds height="28.0" width="28.0" x="1490.0" y="201.0"/>
