<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowable.org/samples"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <!-- ===================================================================
       Clearance Letter
       - Started by candidate group STD only (process-level
         candidateStarterGroups + runtime check in ClearanceService).
       - Departments are NEVER hardcoded here: resolveDepartments calls
         DepartmentResolverService.getRequiredDepartments(initiator) and
         stores the result in requiredDepartments.
       - One multi-instance PARALLEL user task creates an approval task per
         department; candidateGroups=${department}; completionCondition
         ${anyDepartmentRejected} cancels remaining tasks on first reject.
       - Rejection at any stage loops back to the initiator amendment task
         and then re-resolves departments (the loop may repeat endlessly).
       - After ALL departments + Finance + Admission approved:
         completeClearance sets clearanceResult=APPROVED, e-mails the
         initiator and creates non-blocking standalone result / FYI tasks.
       =================================================================== -->
  <process id="clearanceLetterProcess" name="Clearance Letter" isExecutable="true" flowable:candidateStarterGroups="STD">

    <documentation>Dynamic multi-instance clearance approval with amendment loop.</documentation>

<!--    <extensionElements>-->
<!--      &lt;!&ndash; Only members of the STD candidate group may start this process. &ndash;&gt;-->
<!--      <flowable:candidateStarterGroups>STD</flowable:candidateStarterGroups>-->
<!--    </extensionElements>-->

    <!-- ===================== Start ===================== -->
    <startEvent id="startClearance" name="Clearance request started (STD)"
                flowable:formKey="start-clearance">
      <extensionElements>
        <flowable:executionListener event="start"
              expression="${clearanceProcessHandler.processStarted(execution)}"/>
      </extensionElements>
    </startEvent>

    <!-- ============ Dynamic department resolution ============ -->
    <serviceTask id="resolveDepartments" name="Resolve Required Departments"
                 flowable:expression="${clearanceProcessHandler.resolveRequiredDepartments(execution)}">
      <documentation>
        Calls DepartmentResolverService.getRequiredDepartments(initiator) and stores
        the result in requiredDepartments. Runs before EVERY approval round
        (start + after each amendment) so the department set is always dynamic.
      </documentation>
    </serviceTask>

    <!-- ============ Parallel multi-instance department approval ============ -->
    <userTask id="departmentApprovalTask" name="Approval: ${department}"
              flowable:candidateGroups="${department}"
              flowable:formKey="clearance-task">
      <documentation>
        One instance per dynamically resolved department (parallel).
        Approve / Reject. The shared ${clearanceTaskListener} sends the
        TASK_ASSIGNED e-mail + audit on create and records the decision on
        complete. completionCondition cancels open sibling tasks as soon as
        anyDepartmentRejected becomes true.
      </documentation>
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${requiredDepartments}"
                                        flowable:elementVariable="department">
        <!-- Leave the stage as soon as ONE department rejects; Flowable then
             destroys the remaining parallel instances (DELETE listeners fire,
             audited as TASK_CANCELLED). All instances done + no rejection
             means the stage is approved. -->
        <completionCondition>${anyDepartmentRejected}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <!-- ============ Stage evaluation / rejection bookkeeping ============ -->
    <serviceTask id="evaluateDepartments" name="Evaluate Department Stage Result"
                 flowable:expression="${clearanceProcessHandler.evaluateDepartmentStage(execution)}">
      <documentation>
        Copies the first rejection of the round (department + comment) into
        lastRejected* variables for the initiator's amendment form.
      </documentation>
    </serviceTask>

    <exclusiveGateway id="gatewayAllApproved" name="All departments approved?"/>

    <!-- ============ Step 1: Finance (sequential) ============ -->
    <userTask id="financeApprovalTask" name="Finance Department Approval"
              flowable:candidateGroups="Finance Department"
              flowable:formKey="clearance-task">
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <exclusiveGateway id="gatewayFinanceDecision" name="Finance approved?"/>

    <serviceTask id="recordFinanceRejection" name="Record Finance Rejection"
                 flowable:expression="${clearanceProcessHandler.recordStageRejection(execution, 'FINANCE', 'Finance Department')}"/>

    <!-- ============ Step 2: Admission and Registration (sequential) ============ -->
    <userTask id="admissionApprovalTask" name="Admission and Registration Approval"
              flowable:candidateGroups="Admission and Registration Department"
              flowable:formKey="clearance-task">
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <exclusiveGateway id="gatewayAdmissionDecision" name="Admission approved?"/>

    <serviceTask id="recordAdmissionRejection" name="Record Admission Rejection"
                 flowable:expression="${clearanceProcessHandler.recordStageRejection(execution, 'ADMISSION_AND_REGISTRATION', 'Admission and Registration Department')}"/>

    <!-- ============ Initiator amendment (rejection loop) ============ -->
    <userTask id="amendClearanceRequestTask" name="Amend Clearance Request"
              flowable:assignee="${initiator}"
              flowable:formKey="clearance-task">
      <documentation>
        Returned to the ORIGINAL initiator whenever any department, Finance or
        Admission rejects. Shows lastRejectedStage / lastRejectedDepartment /
        lastRejectionComment. Completing it loops back to Resolve Required
        Departments - a fresh approval round starts (dynamic again).
      </documentation>
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="complete" delegateExpression="${clearanceTaskListener}"/>
        <flowable:taskListener event="delete" delegateExpression="${clearanceTaskListener}"/>
      </extensionElements>
    </userTask>

    <serviceTask id="recordAmendment" name="Record Amendment"
                 flowable:expression="${clearanceProcessHandler.recordAmendment(execution)}"/>

    <!-- ============ Completion ============ -->
    <serviceTask id="completeClearance" name="Complete Clearance (Result + FYI)"
                 flowable:expression="${clearanceProcessHandler.completeClearance(execution)}">
      <documentation>
        Only reached when ALL dynamically selected departments, Finance and
        Admission approved. Sets clearanceResult=APPROVED, e-mails the
        initiator, creates the initiator result task and the Internal Audit
        FYI task (standalone tasks - neither blocks the process end).
      </documentation>
    </serviceTask>

    <endEvent id="endClearance" name="Clearance finished"/>

    <!-- ===================== Flows ===================== -->
    <sequenceFlow id="flowStart" sourceRef="startClearance" targetRef="resolveDepartments"/>

    <sequenceFlow id="flowResolveToDepartments" sourceRef="resolveDepartments"
                  targetRef="departmentApprovalTask"/>

    <sequenceFlow id="flowDepartmentsToEvaluation" sourceRef="departmentApprovalTask"
                  targetRef="evaluateDepartments"/>

    <sequenceFlow id="flowEvaluationToGateway" sourceRef="evaluateDepartments"
                  targetRef="gatewayAllApproved"/>

    <sequenceFlow id="flowAllApprovedYes" name="all approved"
                  sourceRef="gatewayAllApproved" targetRef="financeApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${!anyDepartmentRejected}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAllApprovedNo" name="rejected"
                  sourceRef="gatewayAllApproved" targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowFinanceToGateway" sourceRef="financeApprovalTask"
                  targetRef="gatewayFinanceDecision"/>

    <sequenceFlow id="flowFinanceApproved" name="approved"
                  sourceRef="gatewayFinanceDecision" targetRef="admissionApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowFinanceRejected" name="rejected"
                  sourceRef="gatewayFinanceDecision" targetRef="recordFinanceRejection"/>
    <sequenceFlow id="flowRecordFinanceRejection" sourceRef="recordFinanceRejection"
                  targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowAdmissionToGateway" sourceRef="admissionApprovalTask"
                  targetRef="gatewayAdmissionDecision"/>

    <sequenceFlow id="flowAdmissionApproved" name="approved"
                  sourceRef="gatewayAdmissionDecision" targetRef="completeClearance">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAdmissionRejected" name="rejected"
                  sourceRef="gatewayAdmissionDecision" targetRef="recordAdmissionRejection"/>
    <sequenceFlow id="flowRecordAdmissionRejection" sourceRef="recordAdmissionRejection"
                  targetRef="amendClearanceRequestTask"/>

    <sequenceFlow id="flowAmendToRecord" sourceRef="amendClearanceRequestTask"
                  targetRef="recordAmendment"/>

    <!-- the amendment loop: back to dynamic department resolution -->
    <sequenceFlow id="flowAmendmentLoop" name="re-resolve departments"
                  sourceRef="recordAmendment" targetRef="resolveDepartments"/>

    <sequenceFlow id="flowCompleteToEnd" sourceRef="completeClearance"
                  targetRef="endClearance"/>

  </process>

  <!-- ===================== Diagram (layout only, engine-irrelevant) ===================== -->
